[hooks]
# Guest function entries wrapped so the port can attach opt-in host hooks.
# Without a registered hook, a wrapper calls the original body directly.
hash = 0x46494373E607F598
0x028E6CFC = hook  # sead::LookAtCamera::doUpdateMatrix (v16 0281ADB4; gx2_env_light.cpp)
0x0200E410 = hook  # agl camera: set field of view in degrees (v16 0200F24C)
0x0285C3A0 = hook  # message broadcast loop guard (v288 0285C3D0; hooks/broadcast_guard.cpp)

[patches]
# 0xADDR = instruction, applied when this manifest is used to recompile
# the image. The instruction is PowerPC assembly (cmpwi, li, stw, b, ...);
# branch targets are absolute guest addresses.
hash = Undefined
0x02668D18 = bl 0x02DDF000  # player camera update (02668434): its input step 026621E8 runs through the mouse-aim thunk (hooks/mouse_aim.cpp); v16 0x025DB0D8

[globals]
# Guest addresses the port code needs by name (not covered by a hash).
# rbrew_game_address() and the RBREW_GAME_* constants are generated from this section.
# Found by matching the v16 code (normalized instruction signatures, data references), see MAJ-V272.md.
allocator            = 0x101EFCC8
sda                  = 0x10277580
ctors                = 0x101DB94C
ctors_done           = 0x101E922C
tls_handle           = 0x101E6AF0
plt_begin            = 0x02DD0000
plt_end              = 0x02DE0000
heap_alloc_slot      = 0x02DD6D78
heap_alloc_ex_slot   = 0x02DD6D80
heap_free_slot       = 0x02DD6D88
fopen_max_slot       = 0x02DD6DC8
blank_stub           = 0x02DD0620
render_manager       = 0x101E7BDC
broadcast_dispatch   = 0x0285C3A0
broadcast_set_current = 0x0285BD24
# Port additions (same meaning as in Gambit_v16.manifest).
mouse_aim_thunk      = 0x02DDF000
mouse_aim_callsite   = 0x02668D18
camera_input         = 0x026621E8
plaza_mode_sync      = 0x02AD5C44
pacer_vsync_return   = 0x0286191C
look_at_camera_update = 0x028E6CFC
camera_set_fov       = 0x0200E410
control_manager      = 0x101DDF64
save_manager         = 0x101E675C
scene_manager        = 0x101E6770
scene_types          = 0x101DCED0
param_vtable_bool    = 0x1015E540
param_vtable_float   = 0x1015F358

